{
  "format_version": "1.0",
  "patterns": [
    {
      "id": "tvm-20015-variant-silu",
      "compiler": "tvm",
      "target": "llvm",
      "description": "silu LLVM shufflevector dominance crash: ndim 3 or 4, C=4 variant",
      "severity": "crash",
      "nodes": [
        {
          "match": "node", "id": "n0", "op": "SILU",
          "inputs": ["v_in"],
          "outputs": ["v_out"],
          "attrs": {}
        }
      ],
      "values": [
        {
          "match": "value", "id": "v_in",
          "ndim": {"$in": [3, 4]},
          "shape": [
            {"$any": true},
            {"$any": true},
            {"$any": true}
          ],
          "dtype": "float32"
        }
      ]
    }
  ]
}