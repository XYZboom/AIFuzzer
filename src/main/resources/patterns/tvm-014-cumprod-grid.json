      "compiler": "tvm",
      "target": "cuda",
      "description": "CUMPROD gridDim.y overflow: 2D axis=0, shape[1] >= 65536 → grid y=65536 > CUDA limit",
      "severity": "crash",
      "nodes": [
        {
