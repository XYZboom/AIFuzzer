{
  "format_version": "1.0",
  "patterns": [
    {
      "id": "tvm-20015",
      "compiler": "tvm",
      "target": "llvm",
      "description": "avg_pool2d LLVM shufflevector dominance crash: C=4, W=3, H≥6 even, kernel_size=2",
      "severity": "crash",
      "nodes": [
        {
          "match": "node", "id": "n0", "op": "AVG_POOL2D",
          "inputs": ["v_in"],
          "outputs": ["v_out"],
          "attrs": {
            "kernel_size": 2,
            "stride": 1,
            "padding": 0
          }
        }
      ],
      "values": [
        {
          "match": "value", "id": "v_in",
          "ndim": 4,
          "shape": [
            {"$any": true},
            {"$eq": 4},
            {"$gte": 6, "$mod": {"d": 2, "r": 0}},
            {"$eq": 3}
          ],
          "dtype": "float32"
        }
      ]
    }
  ]
}